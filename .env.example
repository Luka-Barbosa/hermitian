# System 2 (Gemini, free tier, BYOK). SYSTEM2_MODEL is the default for every task;
# the per-task overrides are optional.
GOOGLE_GENERATIVE_AI_API_KEY=
SYSTEM2_MODEL=gemini-2.5-flash
SYSTEM2_MODEL_PARSE=
SYSTEM2_MODEL_NARRATIVE=
# replay (default, offline) | record (replay, else call Gemini and save) | live
SYSTEM2_BACKEND=replay

# System 1 (Jev via Vercel AI Gateway)
AI_GATEWAY_API_KEY=
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev

# replay (default, offline) | record | jev | gemini (simulated Jev on free Gemini)
DECIDE_BACKEND=replay
# Which live backend `record` mode calls: jev | gemini
RECORD_VIA=jev
# Model for the simulated backend; defaults to SYSTEM2_MODEL
DECIDE_SIM_MODEL=
MAX_LIVE_JEV_CALLS=200

DUCKDB_PATH=./data/hermitian.duckdb
DATA_SEED=42
