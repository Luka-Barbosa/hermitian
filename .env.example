# System 2 (Gemini, free tier, BYOK). SYSTEM2_MODEL is the default for every task;
# the per-task overrides are optional. Any model value may be a comma-separated
# list: when one model's free daily quota runs out, calls move to the next.
GOOGLE_GENERATIVE_AI_API_KEY=
SYSTEM2_MODEL=gemini-3.5-flash
SYSTEM2_MODEL_PARSE=
SYSTEM2_MODEL_NARRATIVE=
# replay (default, offline) | record (replay, else call Gemini and save) | live
SYSTEM2_BACKEND=replay
# Minimum spacing between live Gemini calls, in ms
GEMINI_MIN_INTERVAL_MS=4000

# System 1 (Jev). Two routes. If TYPESAFE_API_KEY is set, calls go straight to TypeSafe's
# API (https://api.typesafe.ai, model jev-latest, both SDK defaults). Otherwise they go
# through the Vercel AI Gateway using the three settings below.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev

# replay (default, offline) | record | jev | gemini (simulated Jev on free Gemini)
DECIDE_BACKEND=replay
# Which live backend `record` mode calls: jev | gemini
RECORD_VIA=jev
# Model(s) for simulated Jev; defaults to SYSTEM2_MODEL
DECIDE_SIM_MODEL=
MAX_LIVE_JEV_CALLS=200

DUCKDB_PATH=./data/hermitian.duckdb
DATA_SEED=42
# Logs each live model attempt to stderr
HERMITIAN_DEBUG=
# Logs each live model attempt to stderr
HERMITIAN_DEBUG=
# `pnpm fixtures:record --refresh` sets this: re-record System 1 fixtures from another source
RECORD_REFRESH=
